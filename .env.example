# La app funciona sin este archivo: usa IA local con Ollama (recomendado).
PORT=3001
DATABASE_PATH=./data/jarvis.sqlite

# ollama (local, privado, sin cuota) | claude (nube, para equipos sin GPU) | gemini (externo) | demo (sin IA)
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
# Debe tener soporte de herramientas (tools): ollama pull qwen3.5:9b
OLLAMA_MODEL=qwen3.5:9b

# Acceso desde el móvil SOLO mediante un proxy HTTPS privado, p. ej. «tailscale serve 3001».
# Escribe aquí el nombre que muestra Tailscale. Nunca abras el puerto a internet.
# JARVIS_ALLOWED_HOSTS=mi-pc.tu-red.ts.net

# Nube (Claude, de Anthropic): con AI_PROVIDER=ollama activa el modo híbrido (interruptor ☁ en el chat,
# solo los mensajes marcados salen del equipo); con AI_PROVIDER=claude, todo el chat usa la nube.
# Requiere tu clave (console.anthropic.com) y EXTERNAL_AI_TERMS_ACCEPTED=true. Se paga por uso:
# claude-opus-5-5 (por defecto) 4/20 USD por millón de tokens de entrada/salida; claude-haiku-5-5 0,10/0,50.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Aceptas enviar datos a un proveedor externo (Claude o Gemini) y revisaste sus condiciones.
EXTERNAL_AI_TERMS_ACCEPTED=false

# Gemini: no activar con datos personales hasta revisar condiciones y privacidad.
# Se requieren las DOS autorizaciones, proveedor gemini y una clave válida.
EXTERNAL_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Límite diario de solicitudes externas (Claude o Gemini; máx. 100). No garantiza coste cero.
# Con AI_PROVIDER=claude súbelo (p. ej. 50): cada mensaje del chat cuenta una vez.
AI_MAX_DAILY_REQUESTS=5
