{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(npm run build *)",
      "Bash(npm run test:e2e *)",
      "Bash(npm run check *)",
      "Bash(node --test *)",
      "Bash(npx playwright test *)",
      "Bash(npx tsc *)",
      "Bash(ollama list *)",
      "Bash(ollama ps *)",
      "Bash(nvidia-smi *)",
      "Bash(curl -s http://127.0.0.1:11434/api/tags *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./data/**)"
    ]
  }
}
